# Neon / Prisma (AD-11) — story 1.2
# Copy to `.env` (gitignored) and fill with your Neon project URLs.

# Pooled connection (runtime + @prisma/adapter-neon)
# Neon UI: "Pooled connection" / DATABASE_URL
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Direct (non-pooled) — migrations
# Neon UI: "Direct connection" / DATABASE_URL_UNPOOLED → map to DIRECT_URL here
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Optional: force Secure cookie locally (default: Secure only on Vercel)
# COOKIE_SECURE=true
