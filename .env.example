# Neon / Prisma (AD-11)
# Pooled connection (runtime + @prisma/adapter-neon)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require"

# Direct (non-pooled) — migrations
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth.js — staff JWT (AD-6). Generate: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# Staff seed credentials (provisionnés — pas de signup public)
STAFF_EMAIL="salle@moeris.local"
STAFF_PASSWORD="changeme"

# Vercel Blob — photos plats BO (AD-10). Optional: upload désactivé si absent.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Pusher — fraîcheur BO (AD-7). Optional: poll-only si absent.
# PUSHER_APP_ID="..."
# PUSHER_KEY="..."
# PUSHER_SECRET="..."
# PUSHER_CLUSTER="..."
# NEXT_PUBLIC_PUSHER_KEY="..."
# NEXT_PUBLIC_PUSHER_CLUSTER="..."

# Google Sheets mirror (AD-8). Optional: Neon-only si absent.
# GOOGLE_SHEETS_ID="..."

# Force cookie Secure on local next start (default: only on VERCEL=1)
# COOKIE_SECURE=true
